---
import Avatar from '../Avatar.astro';
import ButtonLink from '../ButtonLink.astro';
import { site } from '../../data/site';
---

<section class="section hero">
  <div class="wrap hero__grid">
    <Avatar />

    <div class="hero__text">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1 class="hero__title">
        {site.hero.title.line}<br />
      </h1>
      <p class="hero__lede prose">{site.hero.lede}</p>
      <div class="hero__cta">
        {site.hero.actions.map((action) => <ButtonLink {...action} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    margin: 0 0 1.25rem;
  }

  .hero__lede {
    color: var(--ink-soft);
    font-size: 1.12rem;
  }

  .hero__cta {
    display: flex;
    gap: 0.85rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero__grid {
      grid-template-columns: 1fr;
      text-align: left;
      justify-items: start;
    }

    .hero__title br {
      display: none;
    }
  }
</style>
