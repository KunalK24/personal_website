---
import ButtonLink from '../ButtonLink.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__layout">
    <div class="hero__copy">
      <p class="hero__eyebrow">Kunal Kathuria <span>/</span> Software engineer</p>
      <h1 id="hero-title">Building immersive worlds and  <span>exploring AI.</span></h1>
      <p class="hero__intro">I'm Kunal, a software engineer currently based in Los Angeles and open to relocating. I've spent six years building for live service games and online platforms at Blizzard and PlayStation. I'm looking for my next role on a fast-moving team building from the ground up.</p>
      <div class="hero__actions">
        <ButtonLink href="#projects" label="See my projects" />
        <ButtonLink href="mailto:kunaldk98@gmail.com" label="Email me" variant="ghost" />
      </div>
    </div>
    <div class="hero__work" aria-hidden="true">
      <div class="hero__work-card hero__work-card--aurorian">
        <span>Aurorian Studios</span>
        <strong>DevOps &amp; Gameplay</strong>
        <i></i>
      </div>
      <div class="hero__work-card hero__work-card--blizzard">
        <span>Blizzard Entertainment</span>
        <strong>Server &amp; Gameplay</strong>
        <i></i>
      </div>
      <div class="hero__work-card hero__work-card--playstation">
        <span>Playstation</span>
        <strong>Trust &amp; Safety</strong>
        <i></i>
      </div>
      <div class="hero__work-card hero__work-card--pantry">
        <span>Pantry</span>
        <strong>Personal project</strong>
        <i></i>
      </div>
    </div>
  </div>
</section>
