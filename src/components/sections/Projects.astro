---
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';
import pasta from '../../assets/pantry/pasta.png';
import appleTart from '../../assets/pantry/apple-tart.png';
import lemonCake from '../../assets/pantry/lemon-cake.png';
---

<section id="projects" class="projects-section" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="projects__header">
      <div>
        <p class="section-label">Work</p>
        <h2 id="projects-title" class="section-heading">Projects</h2>
      </div>
      <p>Check out what I've working on in my free time!</p>
    </div>
    <ul class="project-list">
      {projects.map((project) => (
        <li class:list={['project', `project--${project.visual}`]}>
          <div class="project__visual" aria-hidden="true">
            <span class="preview-label">Illustrative project visual</span>
            {project.visual === 'pantry' ? (
              <div class="pantry-window">
                <div class="window-bar">
                  <span class="window-dots"><i></i><i></i><i></i></span>
                  <span>pantry / recipes</span>
                </div>
                <div class="pantry-window__content">
                  <div class="pantry-window__side">
                    <strong>pantry<span>.</span></strong>
                    <i></i><i></i><i></i>
                  </div>
                  <div class="pantry-window__main">
                    <h4>Recipe Book</h4>
                    <div class="pantry-tiles">
                      <div class="pantry-tile"><Image src={pasta} width={160} height={120} alt="" /><small>Tomato pasta</small></div>
                      <div class="pantry-tile"><Image src={appleTart} width={160} height={120} alt="" /><small>Apple tart</small></div>
                      <div class="pantry-tile"><Image src={lemonCake} width={160} height={120} alt="" /><small>Lemon cake</small></div>
                    </div>
                    <div class="pantry-window__footer"><span>Recipe ideas</span><b></b></div>
                  </div>
                </div>
              </div>
            ) : (
              <div class="battle-window">
                <div class="window-bar">
                  <span class="window-dots"><i></i><i></i><i></i></span>
                  <span>ai battle royal / arena</span>
                </div>
                <div class="battle-window__content">
                  <p class="battle-window__eyebrow">Challenge in progress</p>
                  <h4>One problem. Different approaches.</h4>
                  <div class="battle-window__agents">
                    <div class="battle-agent">
                      <span>Agent A</span>
                      <i></i><i></i><i></i>
                    </div>
                    <div class="battle-agent">
                      <span>Agent B</span>
                      <i></i><i></i><i></i>
                    </div>
                  </div>
                  <div class="battle-window__footer">Watching the solutions take shape</div>
                </div>
              </div>
            )}
          </div>
          <div class="project__body">
            <p class="project__type">{project.category}</p>
            <h3 class="project__name">{project.name}</h3>
            <p class="project__blurb">{project.blurb}</p>
            <div class="project__end">
              <ul class="project__tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
              <a class="text-link" href={project.href}>{project.linkLabel}</a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
