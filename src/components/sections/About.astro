---
import { site } from '../../data/site';
---

<section id="about" class="section">
  <div class="wrap">
    <p class="eyebrow">About</p>
    <div class="prose about">
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about p {
    font-size: 1.08rem;
  }
</style>
