---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { site } from '../../data/site';

type Props = {
  posts: CollectionEntry<'cooking'>[];
};

const { posts } = Astro.props;
const fmtDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<section id="cooking" class="section">
  <div class="wrap">
    <p class="eyebrow">Cooking</p>
    <p class="prose cooking__intro">{site.cooking.intro}</p>
    <ul class="cooking">
      {posts.map((post) => (
        <li class="dish">
          <div class="dish__photo">
            {post.data.image ? (
              <Image src={post.data.image} alt={post.data.title} loading="lazy" />
            ) : (
              <div class="dish__photo--empty" aria-hidden="true">Cooking</div>
            )}
          </div>
          <div class="dish__body">
            <h3 class="dish__title">{post.data.title}</h3>
            <p class="dish__date">{fmtDate(post.data.date)}</p>
            <p class="dish__note">{post.data.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cooking__intro {
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .cooking {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .dish {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .dish__photo {
    aspect-ratio: 4 / 3;
    background: #eaeede;
  }

  .dish__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dish__photo--empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--olive-deep);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .dish__body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .dish__title {
    font-size: 1.15rem;
    margin: 0 0 0.2rem;
  }

  .dish__date {
    font-size: 0.8rem;
    color: var(--olive-deep);
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }

  .dish__note {
    color: var(--ink-soft);
    font-size: 0.96rem;
    margin: 0;
  }
</style>
