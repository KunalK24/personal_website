---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = { posts: CollectionEntry<'cooking'>[] };
const { posts } = Astro.props;
const fmtDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<section id="cooking" class="cooking-section" aria-labelledby="cooking-title">
  <div class="wrap">
    <div class="cooking__header">
      <div>
        <p class="section-label">Away from the keyboard</p>
        <h2 id="cooking-title" class="section-heading">Cooking</h2>
      </div>
      <p>I keep a few photos and notes from things I've made. Some worked on the first try; others are still getting there.</p>
    </div>
    <div class="cooking-carousel" data-cooking-carousel>
      <button class="cooking-arrow cooking-arrow--prev" type="button" aria-label="Previous dishes" aria-controls="cooking-list" data-cooking-prev disabled>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <ul id="cooking-list" class="cooking-grid" data-cooking-track>
        {posts.map((post) => (
          <li class="dish">
            <div class="dish__image">
              {post.data.image && <Image src={post.data.image} alt={post.data.title} loading="lazy" />}
            </div>
            <div class="dish__info">
              <p class="dish__date">{fmtDate(post.data.date)}</p>
              <h3 class="dish__title">{post.data.title}</h3>
              <p class="dish__note">{post.data.note}</p>
            </div>
          </li>
        ))}
      </ul>
      <button class="cooking-arrow cooking-arrow--next" type="button" aria-label="Next dishes" aria-controls="cooking-list" data-cooking-next>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-cooking-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-cooking-track]');
  const previous = carousel?.querySelector<HTMLButtonElement>('[data-cooking-prev]');
  const next = carousel?.querySelector<HTMLButtonElement>('[data-cooking-next]');

  if (track && previous && next) {
    const updateButtons = () => {
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    const scrollDish = (direction: number) => {
      const dishes = [...track.querySelectorAll<HTMLElement>('.dish')];
      if (!dishes.length) return;
      const current = dishes.reduce((nearest, dish, index) =>
        Math.abs(dish.offsetLeft - track.scrollLeft) < Math.abs(dishes[nearest].offsetLeft - track.scrollLeft)
          ? index
          : nearest, 0);
      const target = dishes[Math.max(0, Math.min(dishes.length - 1, current + direction))];
      track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
    };

    previous.addEventListener('click', () => scrollDish(-1));
    next.addEventListener('click', () => scrollDish(1));
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }
</script>
