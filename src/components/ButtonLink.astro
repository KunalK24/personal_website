---
type Props = {
  href: string;
  label: string;
  variant?: 'ghost';
  download?: boolean;
};

const { href, label, variant, download } = Astro.props;
const className = variant === 'ghost' ? 'btn btn--ghost' : 'btn';
---

<a class={className} href={href} download={download ? true : undefined}>{label}</a>

<style>
  .btn {
    display: inline-block;
    background: var(--olive);
    color: #fbfaf4;
    padding: 0.62rem 1.15rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.98rem;
    border: 1px solid var(--olive);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .btn:hover {
    background: var(--olive-deep);
    color: #fbfaf4;
  }

  .btn--ghost {
    background: transparent;
    color: var(--forest);
    border-color: var(--line);
  }

  .btn--ghost:hover {
    background: var(--bg-raised);
    color: var(--forest);
    border-color: var(--olive);
  }
</style>
